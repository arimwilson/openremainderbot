+    def test_booking_waits_for_staff_write_and_then_sees_block(self):
+        conn = db.connect(self.path)
+        self.addCleanup(conn.close)
+        conn.execute("BEGIN IMMEDIATE")
+        conn.execute("INSERT INTO time_off (groomer_id, starts_on, start_time, end_time, repeat)"
+                     " VALUES (1, '2026-10-13', '12:30', '13:00', 'once')")
+        attempted, finished = threading.Event(), threading.Event()
+        outcome = []
+
+        def booking():
+            other = db.connect(self.path)
+            other.set_trace_callback(lambda sql: attempted.set() if sql == "BEGIN IMMEDIATE" else None)
+            try:
+                scheduling.book(other, 1, 1, 1, at(12, 30))
+                outcome.append("booked")
+            except Exception as exc:
+                outcome.append(exc)
+            finally:
+                other.close()
+                finished.set()
+
+        worker = threading.Thread(target=booking, daemon=True)
+        worker.start()
+        try:
+            self.assertTrue(attempted.wait(2), "booking never attempted to acquire its write lock")
+            self.assertFalse(finished.is_set(), "booking read availability before staff committed")
+        finally:
+            conn.commit()
+            worker.join(5)
+        self.assertFalse(worker.is_alive())
+        self.assertIsInstance(outcome[0], scheduling.BookingError)
+        self.assertIn("time off", str(outcome[0]))
