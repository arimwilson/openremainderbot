+    <p class="local-time">All times are local to the salon.</p>
+  </div>
+  <div id="page-message" class="message" role="status" hidden></div>
+  <div class="columns">
+    <div>
+      <section class="card" aria-labelledby="day-heading">
+        <div class="card-head"><div><h2 id="day-heading">Your day</h2><p id="hours" class="subtle">Loading the schedule…</p></div><span id="date-mark" class="date-mark"></span></div>
+        <div id="agenda" class="agenda" aria-live="polite"></div>
+      </section>
+      <section class="card saved" aria-labelledby="saved-heading">
+        <div class="card-head"><div><h2 id="saved-heading">Saved time off</h2><p class="subtle">One-off dates and weekly routines for this groomer.</p></div></div>
+        <ul id="saved-list" class="saved-list"></ul>
+      </section>
+    </div>
+    <section class="card" aria-labelledby="form-heading">
+      <div class="card-head"><div><h2 id="form-heading">Block some time</h2><p id="form-groomer" class="subtle"></p></div></div>
+      <form id="block-form" class="form-body">
+        <div id="form-message" class="message" role="status" hidden></div>
+        <div class="field"><label for="starts-on">Date</label><input id="starts-on" name="starts_on" type="date" required></div>
+        <div class="two field"><div><label for="start-time">From</label><input id="start-time" name="start_time" type="time" value="12:30" step="60" required></div><div><label for="end-time">To</label><input id="end-time" name="end_time" type="time" value="13:00" step="60" required></div></div>
+        <div class="field"><label for="repeat">Repeat</label><select id="repeat" name="repeat"><option value="once">Does not repeat</option><option value="weekly">Every week</option></select><p id="repeat-hint" class="hint">Just this date.</p></div>
+        <div class="field"><label for="note">Label <span class="subtle">(optional)</span></label><input id="note" name="note" maxlength="120" placeholder="Lunch, personal appointment…" autocomplete="off"><p class="hint">Only visible here. Never added to client reminders.</p></div>
+        <button type="submit" class="button primary" id="save">Save time off</button>
+      </form>
+      <div class="protection"><strong>Existing bookings stay put.</strong> If a booking overlaps, we’ll ask you to move or cancel it first. Weekly time off starts on the date you choose.</div>
+    </section>
+  </div>
+  <footer>Blocks stay in place until you remove them. Overlapping blocks each apply independently.</footer>
+</main>
+<dialog id="remove-dialog" aria-labelledby="remove-heading"><h2 id="remove-heading">Remove time off?</h2><p id="remove-description"></p><p class="subtle">Other blocks and existing bookings still apply.</p><div id="remove-message" class="message error" role="status" hidden></div><div class="dialog-actions"><button id="keep" class="button">Keep it</button><button id="confirm-remove" class="button danger">Remove time off</button></div></dialog>
+<script nonce="$token">
+'use strict';
+const el = id => document.getElementById(id);
+const groomer = el('groomer'), viewDate = el('view-date'), form = el('block-form');
+const token = document.querySelector('meta[name="fernhill-token"]').content;
+let generation = 0, removing = null, writing = false;
+const localISO = date => date.getFullYear() + '-' + String(date.getMonth()+1).padStart(2,'0') + '-' + String(date.getDate()).padStart(2,'0');
+const fromISO = value => new Date(value + 'T12:00:00');
+const prettyDate = value => fromISO(value).toLocaleDateString(undefined, {month:'short', day:'numeric', year:'numeric'});
+const weekday = value => fromISO(value).toLocaleDateString(undefined, {weekday:'long'});
+function node(tag, className, text) { const n=document.createElement(tag); if(className) n.className=className; if(text !== undefined) n.textContent=text; return n; }
+function message(id, text, error=false) { const target=el(id); target.textContent=text; target.hidden=!text; target.classList.toggle('error',error); }
+async function api(path, options={}) {
+  const response = await fetch(path, {...options, headers:{'Content-Type':'application/json','X-Fernhill-Token':token,...options.headers}});
+  let data;
+  try { data = await response.json(); } catch { throw new Error('Could not read the schedule. Refresh and try again.'); }
+  if (!response.ok) throw new Error(data.error || 'Could not update the schedule. Try again.');
+  return data;
+}
+function repeatHint() {
+  const value=el('starts-on').value;
+  el('repeat-hint').textContent=el('repeat').value==='weekly' && value
+    ? 'Every ' + weekday(value) + ', from ' + prettyDate(value) + ' until removed.' : 'Just this date.';
+}
+function renderAgenda(data) {
+  const agenda=el('agenda'); agenda.replaceChildren();
+  el('day-heading').textContent=weekday(viewDate.value);
+  el('date-mark').textContent=prettyDate(viewDate.value);
+  el('hours').textContent=data.hours ? 'Salon open ' + data.hours.join('–') : 'Salon closed · no times offered';
+  const stats=node('div','stats');
+  for (const [text, kind] of [[data.appointments.length + ' appointments',''],[data.blocks.length + ' time-off blocks','break']]) {
+    const stat=node('span'); stat.append(node('i','dot ' + kind),document.createTextNode(text)); stats.append(stat);
+  }
+  agenda.append(stats);
+  const events = data.appointments.map(a => ({start:a.start.slice(11,16), end:a.end.slice(11,16), title:a.dog, detail:a.service, off:false}));
+  events.push(...data.blocks.map(b => ({start:b.start_time,end:b.end_time,title:b.note || 'Time off',detail:b.repeat==='weekly' ? 'Time off · Every ' + weekday(b.starts_on) : 'Time off · Just this date',off:true})));
+  events.sort((a,b) => a.start.localeCompare(b.start));
+  if (!events.length) { const empty=node('div','empty'); empty.append(node('strong','',data.hours ? 'Room to breathe' : 'A day away'),document.createTextNode(data.hours ? 'No appointments or time off on this day.' : 'You can still plan time off for this date.')); agenda.append(empty); }
+  for (const event of events) {
+    const row=node('div','event' + (event.off ? ' off' : '')), detail=node('div','event-main');
+    detail.append(node('p','event-title',event.title),node('p','event-meta',event.detail));
+    row.append(node('div','event-time',event.start + '–' + event.end),detail); agenda.append(row);
+  }
+}
+function renderSaved(blocks) {
+  const list=el('saved-list'); list.replaceChildren();
+  if (!blocks.length) { list.append(node('li','saved-empty','No time off saved yet. Start with a lunch break.')); return; }
+  for (const block of blocks) {
+    const row=node('li','saved-row'), info=node('div','saved-info'), title=node('p');
+    title.append(node('span','tag',block.repeat==='weekly' ? 'Weekly' : 'One-off'),document.createTextNode(block.note || 'Time off'));
+    const when=block.repeat==='weekly' ? 'Every ' + weekday(block.starts_on) + ' · from ' + prettyDate(block.starts_on) : prettyDate(block.starts_on);
+    info.append(title,node('p','saved-detail',when + ' · ' + block.start_time + '–' + block.end_time));
+    const remove=node('button','remove','Remove'); remove.type='button'; remove.disabled=writing;
+    remove.setAttribute('aria-label','Remove ' + (block.note || 'time off') + ' ' + when);
+    remove.addEventListener('click',() => {
+      removing=block;
+      el('remove-description').textContent=block.repeat==='weekly'
+        ? 'Remove every occurrence of “' + (block.note || 'Time off') + '” on ' + weekday(block.starts_on) + 's?'
+        : 'Remove “' + (block.note || 'Time off') + '” on ' + prettyDate(block.starts_on) + '?';
+      message('remove-message',''); el('remove-dialog').showModal(); el('keep').focus();
+    });
+    row.append(info,remove); list.append(row);
+  }
+}
+async function refresh() {
+  const version=++generation;
+  if (!groomer.value || !viewDate.value) return;
+  const query=new URLSearchParams({groomer:groomer.value,date:viewDate.value});
+  el('form-groomer').textContent='For ' + groomer.selectedOptions[0].textContent;
+  el('agenda').setAttribute('aria-busy','true');
+  try {
+    const [schedule,saved]=await Promise.all([api('/api/schedule?' + query),api('/api/time-off?' + query)]);
+    if (version !== generation) return;
+    renderAgenda(schedule); renderSaved(saved.blocks);
+  } catch(error) {
+    if(version !== generation) return;
+    el('agenda').replaceChildren(node('p','empty','Schedule unavailable. Refresh to try again.'));
+    el('saved-list').replaceChildren(); message('page-message',error.message,true);
+  } finally { if(version===generation) el('agenda').removeAttribute('aria-busy'); }
+}
+function setWriting(value) {
+  writing=value;
+  for (const control of document.querySelectorAll('input,select,button')) control.disabled=value;
+  el('save').textContent=value ? 'Saving…' : 'Save time off';
+}
+function changeDay() { if(!viewDate.value) return; el('starts-on').value=viewDate.value; repeatHint(); message('page-message',''); message('form-message',''); refresh(); }
+groomer.addEventListener('change',() => { message('page-message',''); message('form-message',''); refresh(); });
+viewDate.addEventListener('change',changeDay);
+for (const [id,offset] of [['prev',-1],['next',1]]) el(id).addEventListener('click',() => { const d=fromISO(viewDate.value || localISO(new Date())); d.setDate(d.getDate()+offset); viewDate.value=localISO(d); changeDay(); });
+el('today').addEventListener('click',() => { viewDate.value=localISO(new Date()); changeDay(); });
+el('starts-on').addEventListener('change',repeatHint); el('repeat').addEventListener('change',repeatHint);
+form.addEventListener('submit',async event => {
+  event.preventDefault(); if(writing) return;
+  const payload=Object.fromEntries(new FormData(form)); payload.groomer_id=Number(groomer.value);
+  message('form-message',''); message('page-message','');
+  if(payload.start_time >= payload.end_time) { message('form-message','End time must be after start time on the same day.',true); el('end-time').focus(); return; }
+  setWriting(true);
+  try {
+    await api('/api/time-off',{method:'POST',body:JSON.stringify(payload)});
+    viewDate.value=payload.starts_on;
+    message('form-message',payload.repeat==='weekly' ? 'Weekly time off saved. These times are now blocked.' : 'Time off saved. These times are now blocked.');
+    await refresh();
+  } catch(error) { message('form-message',error.message,true); }
+  finally { setWriting(false); }
+});
+el('keep').addEventListener('click',() => el('remove-dialog').close());
+el('remove-dialog').addEventListener('cancel',event => { if(writing) event.preventDefault(); });
+el('confirm-remove').addEventListener('click',async () => {
+  if(!removing || writing) return;
+  setWriting(true); message('page-message','');
+  try {
+    await api('/api/time-off/' + removing.id,{method:'DELETE'});
+    el('remove-dialog').close(); removing=null;
+    message('page-message','Time off removed. Available times have been updated.'); await refresh();
+  } catch(error) { message('remove-message',error.message,true); }
+  finally { setWriting(false); }
+});
+viewDate.value=localISO(new Date()); el('starts-on').value=viewDate.value;
+if (!groomer.options.length) { setWriting(true); el('save').textContent='Save time off'; message('page-message','Add a groomer to the salon before planning time off.',true); }
+else refresh();
+</script>
+</body>
+</html>
diff --git a/fernhill/staff.py b/fernhill/staff.py
new file mode 100644
index 0000000..fc48dd8
--- /dev/null
+++ b/fernhill/staff.py
@@ -0,0 +1,105 @@
+"""Local-only staff app. Deliberately separate from the public booking WSGI app."""
+from __future__ import annotations
+
+import json
+import secrets
+import sqlite3
+from html import escape
+from pathlib import Path
+from string import Template
+from urllib.parse import parse_qs, urlsplit
+
+from . import scheduling, time_off
+from .db import salon
+
+
+def make_app(conn: sqlite3.Connection):
+    token = secrets.token_urlsafe(32)
+    template = Template(Path(__file__).with_name("staff.html").read_text(encoding="utf-8"))
+
+    def app(environ, start_response):
+        def reply(status, body, content_type="application/json"):
+            data = (body if isinstance(body, str) else json.dumps(body)).encode("utf-8")
+            start_response(status, [("Content-Type", content_type + "; charset=utf-8"),
+                                    ("Content-Length", str(len(data))),
+                                    ("Cache-Control", "no-store"),
+                                    ("X-Content-Type-Options", "nosniff"),
+                                    ("X-Frame-Options", "DENY"),
+                                    ("Content-Security-Policy", "default-src 'self'; "
+                                     "script-src 'nonce-" + token + "'; style-src 'unsafe-inline'; "
+                                     "frame-ancestors 'none'; base-uri 'none'; form-action 'self'")])
+            return [data]
+
+        # Prevent DNS rebinding of the loopback server, in addition to the mutation
+        # token below. No CORS headers are supplied, so other sites cannot read it.
+        try:
+            host = urlsplit("//" + environ.get("HTTP_HOST", "")).hostname
+        except ValueError:
+            host = None
+        if host not in ("localhost", "127.0.0.1", "::1"):
+            return reply("403 Forbidden", {"error": "Use the localhost staff address."})
+        method, path = environ["REQUEST_METHOD"], environ.get("PATH_INFO", "/")
+        if method not in ("GET", "POST", "DELETE"):
+            return reply("405 Method Not Allowed", {"error": "Method not allowed."})
+        if method in ("POST", "DELETE") and not secrets.compare_digest(
+                environ.get("HTTP_X_FERNHILL_TOKEN", "").encode("utf-8"), token.encode("ascii")):
+            return reply("403 Forbidden", {"error": "Refresh the staff page and try again."})
+
+        try:
+            q = {k: v[0] for k, v in parse_qs(environ.get("QUERY_STRING", "")).items()}
+            if method == "GET" and path == "/":
+                options = "".join(
+                    f'<option value="{row["id"]}">{escape(row["name"])}</option>'
+                    for row in conn.execute("SELECT * FROM groomers ORDER BY name, id"))
+                return reply("200 OK", template.substitute(
+                    salon=escape(salon(conn)["name"]), groomers=options, token=token), "text/html")
+            if method == "GET" and path == "/api/time-off":
+                rows = time_off.list_blocks(conn, int(q["groomer"]))
+                return reply("200 OK", {"blocks": [dict(row) for row in rows]})
+            if method == "GET" and path == "/api/schedule":
+                groomer_id, day = int(q["groomer"]), time_off.parse_day(q["date"])
+                blocks = time_off.list_blocks(conn, groomer_id)
+                hours = scheduling.hours(conn, day)
+                # Filter on the ID, not the display name: groomers can share names.
+                rows = conn.execute(
+                    "SELECT a.id, a.start, a.end, d.name AS dog, s.name AS service"
+                    " FROM appointments a JOIN dogs d ON d.id = a.dog_id"
+                    " JOIN services s ON s.id = a.service_id"
+                    " WHERE a.groomer_id = ? AND a.status = 'booked' AND substr(a.start, 1, 10) = ?"
+                    " ORDER BY a.start", (groomer_id, day.isoformat()))
+                appointments = [dict(row) for row in rows]
+                return reply("200 OK", {
+                    "hours": [h.strftime("%H:%M") for h in hours] if hours else None,
+                    "appointments": appointments,
+                    "blocks": [dict(row) for row in blocks if time_off.applies(row, day)]})
+            if method == "POST" and path == "/api/time-off":
+                if environ.get("CONTENT_TYPE", "").split(";", 1)[0].strip() != "application/json":
+                    return reply("415 Unsupported Media Type", {"error": "Send JSON."})
+                length = int(environ.get("CONTENT_LENGTH") or 0)
+                if length < 1 or length > 4096:
+                    return reply("413 Content Too Large", {"error": "Send a block smaller than 4 KB."})
+                body = json.loads(environ["wsgi.input"].read(length))
+                if not isinstance(body, dict):
+                    raise time_off.TimeOffError("Send one time-off block.")
+                block_id = time_off.add_block(
+                    conn, body["groomer_id"], body["starts_on"], body["start_time"],
+                    body["end_time"], body.get("repeat", "once"), body.get("note", ""))
+                return reply("201 Created", {"id": block_id})
+            if method == "DELETE" and path.startswith("/api/time-off/"):
+                time_off.remove_block(conn, int(path.removeprefix("/api/time-off/")))
+                return reply("200 OK", {"removed": True})
+            return reply("404 Not Found", {"error": "Not found."})
+        except time_off.TimeOffConflict as exc:
+            return reply("409 Conflict", {"error": str(exc)})
+        except time_off.TimeOffError as exc:
+            return reply("400 Bad Request", {"error": str(exc)})
+        except (KeyError, ValueError, TypeError):
+            return reply("400 Bad Request", {"error": "Check the groomer, date, and times and try again."})
+        except LookupError as exc:
+            return reply("404 Not Found", {"error": str(exc)})
+        except sqlite3.OperationalError as exc:
+            if "locked" not in str(exc).lower():
+                raise
+            return reply("503 Service Unavailable", {"error": "The schedule is busy. Try again shortly."})
+
+    return app
diff --git a/fernhill/time_off.py b/fernhill/time_off.py
new file mode 100644
index 0000000..7caf4f1
--- /dev/null
+++ b/fernhill/time_off.py
@@ -0,0 +1,115 @@
+"""One-off and weekly groomer time off, expressed in the salon's local time."""
+from __future__ import annotations
+
+import sqlite3
+from datetime import date, datetime, time
+
+from .db import schedule_write
+
+
+class TimeOffError(ValueError):
+    """Invalid time-off input; safe to show to the staff member."""
+
+
+class TimeOffConflict(TimeOffError):
+    """A block would overlap an existing booked appointment."""
+
+
+def groomer_exists(conn: sqlite3.Connection, groomer_id: int) -> None:
+    if type(groomer_id) is not int or groomer_id < 1:
+        raise TimeOffError("Choose a groomer.")
+    if conn.execute("SELECT 1 FROM groomers WHERE id = ?", (groomer_id,)).fetchone() is None:
+        raise TimeOffError("That groomer doesn't exist.")
+
+
+def parse_day(value: str) -> date:
+    try:
+        result = date.fromisoformat(value)
+        if result.isoformat() == value:
+            return result
+    except (TypeError, ValueError):
+        pass
+    raise TimeOffError("Choose a date in YYYY-MM-DD format.")
+
+
+def parse_time(value: str) -> time:
+    try:
+        result = time.fromisoformat(value)
+        if result.tzinfo is None and result.isoformat(timespec="minutes") == value:
+            return result
+    except (TypeError, ValueError):
+        pass
+    raise TimeOffError("Use a local time in HH:MM format.")
+
+
+def applies(block, day: date) -> bool:
+    first = date.fromisoformat(block["starts_on"])
+    return day == first or (block["repeat"] == "weekly" and day >= first
+                            and day.weekday() == first.weekday())
+
+
+def list_blocks(conn: sqlite3.Connection, groomer_id: int) -> list[sqlite3.Row]:
+    groomer_exists(conn, groomer_id)
+    return conn.execute(
+        "SELECT * FROM time_off WHERE groomer_id = ? ORDER BY starts_on, start_time, id",
+        (groomer_id,)).fetchall()
+
+
+def intervals(conn: sqlite3.Connection, groomer_id: int,
+              day: date) -> list[tuple[datetime, datetime]]:
+    rows = conn.execute(
+        "SELECT * FROM time_off WHERE groomer_id = ? AND starts_on <= ?"
+        " AND (repeat = 'weekly' OR starts_on = ?)",
+        (groomer_id, day.isoformat(), day.isoformat()))
+    return [(datetime.combine(day, time.fromisoformat(r["start_time"])),
+             datetime.combine(day, time.fromisoformat(r["end_time"])))
+            for r in rows if applies(r, day)]
+
+
+def add_block(conn: sqlite3.Connection, groomer_id: int, starts_on: str,
+              start_time: str, end_time: str, repeat: str = "once", note: str = "") -> int:
+    """Create a block; weekly blocks start on starts_on and recur until removed.
+
+    Existing appointments are never moved/cancelled. Any booked appointment on an
+    affected date rejects the whole block. Overlapping blocks are allowed; removing
+    one leaves the others in force. Times must be within one calendar day.
+    """
+    first = parse_day(starts_on)
+    start, end = parse_time(start_time), parse_time(end_time)
+    if start >= end:
+        raise TimeOffError("End time must be after start time on the same day.")
+    if repeat not in ("once", "weekly"):
+        raise TimeOffError("Choose once or weekly.")
+    if not isinstance(note, str) or len(note.strip()) > 120:
+        raise TimeOffError("Keep the note to 120 characters or fewer.")
+    note = note.strip()
+    if any(ord(c) < 32 or ord(c) == 127 for c in note):
+        raise TimeOffError("Keep the note on one line.")
+    block = {"starts_on": starts_on, "repeat": repeat}
+    with schedule_write(conn):
+        groomer_exists(conn, groomer_id)
+        rows = conn.execute(
+            "SELECT start, end FROM appointments WHERE groomer_id = ? AND status = 'booked'"
+            " AND end > ? ORDER BY start", (groomer_id, first.isoformat()))
+        for row in rows:
+            booked_start, booked_end = (datetime.fromisoformat(row[key]) for key in ("start", "end"))
+            day = booked_start.date()
+            if applies(block, day) and (datetime.combine(day, start) < booked_end
+                                       and booked_start < datetime.combine(day, end)):
+                raise TimeOffConflict(
+                    f"This overlaps a booked appointment on {day:%Y-%m-%d} at {booked_start:%H:%M}. "
+                    "Move or cancel that appointment before adding time off.")
+        cur = conn.execute(
+            "INSERT INTO time_off (groomer_id, starts_on, start_time, end_time, repeat, note)"
+            " VALUES (?, ?, ?, ?, ?, ?)",
+            (groomer_id, starts_on, start_time, end_time, repeat, note))
+        return cur.lastrowid
+
+
+def remove_block(conn: sqlite3.Connection, block_id: int) -> None:
+    if type(block_id) is not int or block_id < 1:
+        raise TimeOffError("Choose a saved block.")
+    with schedule_write(conn):
+        cur = conn.execute("DELETE FROM time_off WHERE id = ?", (block_id,))
+        if cur.rowcount == 0:
+            raise LookupError("That block no longer exists. Refresh the list.")
