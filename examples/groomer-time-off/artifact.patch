@@ -49,6 +50,17 @@ CREATE TABLE IF NOT EXISTS appointments (
     end TEXT NOT NULL,
     status TEXT NOT NULL DEFAULT 'booked' CHECK (status IN ('booked', 'cancelled', 'done'))
 );
+CREATE TABLE IF NOT EXISTS time_off (
+    id INTEGER PRIMARY KEY,
+    groomer_id INTEGER NOT NULL REFERENCES groomers(id),
+    starts_on TEXT NOT NULL,         -- first date, also the weekday for weekly blocks
+    start_time TEXT NOT NULL,        -- 'HH:MM', salon local time
+    end_time TEXT NOT NULL,
+    repeat TEXT NOT NULL CHECK (repeat IN ('once', 'weekly')),
+    note TEXT NOT NULL DEFAULT '' CHECK (length(note) <= 120),
+    CHECK (start_time < end_time)
+);
+CREATE INDEX IF NOT EXISTS time_off_groomer_date ON time_off (groomer_id, starts_on);
 """
 
 
@@ -60,6 +72,18 @@ def connect(path: str = ":memory:") -> sqlite3.Connection:
     return conn
 
 
+@contextmanager
+def schedule_write(conn: sqlite3.Connection):
+    """Serialize availability checks and writes across staff and booking connections.
+
+    Like book(), callers must finish any unrelated transaction before calling.
+    BEGIN IMMEDIATE obtains the write lock before reading availability.
+    """
+    conn.execute("BEGIN IMMEDIATE")
+    with conn:
+        yield
+
+
 def salon(conn: sqlite3.Connection) -> sqlite3.Row:
     row = conn.execute("SELECT * FROM salon ORDER BY id LIMIT 1").fetchone()
     if row is None:
