@@ -0,0 +1,198 @@
+import csv
+import io
+import unittest
+from datetime import date
+from urllib.parse import urlencode
+
+from fernhill import exports, reports, web
+
+from .fixtures import salon_db
+from .test_exports import add_appointment
+
+
+def request(app, path="/", query="", method="GET", **overrides):
+    environ = {"REQUEST_METHOD": method, "PATH_INFO": path, "QUERY_STRING": query,
+               "REMOTE_ADDR": "127.0.0.1", "SERVER_PORT": "8001", "HTTP_HOST": "127.0.0.1:8001",
+               "wsgi.input": io.BytesIO(b""), "CONTENT_LENGTH": "0"}
+    environ.update(overrides)
+    response = []
+    def start_response(status, headers):
+        response.extend((int(status.split()[0]), dict(headers)))
+    body = b"".join(app(environ, start_response))
+    return response[0], response[1], body
+
+
+class ReportsTest(unittest.TestCase):
+    def setUp(self):
+        self.conn = salon_db()
+        self.addCleanup(self.conn.close)
+        self.app = reports.make_app(self.conn, today=date(2026, 11, 5))
+        self.query = "start=2026-10-01&end=2026-10-31&status=all"
+
+    def test_default_is_last_calendar_month(self):
+        code, headers, body = request(self.app)
+        html = body.decode()
+        self.assertEqual(code, 200)
+        self.assertEqual(headers["Content-Type"], "text/html; charset=utf-8")
+        self.assertIn('value="2026-10-01"', html)
+        self.assertIn('value="2026-10-31"', html)
+        self.assertIn("Test Salon", html)
+        self.assertIn("No appointments in this range", html)
+        self.assertIn(exports.PRICE_NOTE, html)
+        self.assertIn('formaction="/appointments.csv"', html)
+
+    def test_common_ranges_handle_year_and_leap_boundaries(self):
+        self.assertEqual(reports.default_selection(date(2026, 1, 5)),
+                         exports.Selection.parse("2025-12-01", "2025-12-31"))
+        self.assertEqual(reports.default_selection(date(2024, 3, 1)),
+                         exports.Selection.parse("2024-02-01", "2024-02-29"))
+        last_month, this_month, last_30 = reports.selections(date(2024, 3, 1), "done")
+        self.assertEqual(this_month[1], exports.Selection.parse("2024-03-01", "2024-03-31", "done"))
+        self.assertEqual(last_30[1], exports.Selection.parse("2024-02-01", "2024-03-01", "done"))
+        self.assertEqual(last_month[1].status, "done")
+
+    def test_preview_includes_counts_and_status_labels(self):
+        for status in exports.STATUSES:
+            add_appointment(self.conn, status=status)
+        code, _, body = request(self.app, query=self.query)
+        html = body.decode()
+        self.assertEqual(code, 200)
+        self.assertIn("CSV · 3 rows", html)
+        self.assertIn("Completed", html)
+        self.assertIn("Cancelled", html)
+        self.assertIn("Download includes all 3 matching rows", html)
+        self.assertEqual(html.count("<tbody>"), 1)
+        self.assertEqual(html.count("<tr>"), 4)
+
+    def test_status_filter_changes_rows_and_selected_control(self):
+        add_appointment(self.conn, status="booked", dog=1)
+        add_appointment(self.conn, status="done", dog=3)
+        code, _, body = request(self.app, query=self.query.replace("status=all", "status=done"))
+        html = body.decode()
+        self.assertEqual(code, 200)
+        self.assertIn("Pepper", html)
+        self.assertNotIn("Biscuit", html)
+        self.assertIn('<option value="done" selected>', html)
+        self.assertIn("CSV · 1 row", html)
+
+    def test_preview_is_paginated_but_download_has_every_matching_row(self):
+        for _ in range(125):
+            add_appointment(self.conn)
+        _, _, first = request(self.app, query=self.query)
+        self.assertIn(b"Showing 1", first)
+        self.assertEqual(first.count(b"<tr>"), 51)
+        self.assertIn(b'rel="next"', first)
+        _, _, last = request(self.app, query=self.query + "&page=3")
+        self.assertIn(b"Showing 101", last)
+        self.assertEqual(last.count(b"<tr>"), 26)
+        self.assertNotIn(b'rel="next"', last)
+        _, _, download = request(self.app, "/appointments.csv", self.query + "&page=3")
+        self.assertEqual(len(list(csv.DictReader(io.StringIO(download.decode("utf-8-sig"))))), 125)
+
+    def test_out_of_range_preview_page_is_clamped(self):
+        add_appointment(self.conn)
+        code, _, body = request(self.app, query=self.query + "&page=999999999999999999999")
+        self.assertEqual(code, 200)
+        self.assertIn(b"Showing 1", body)
+        self.assertIn(b"Biscuit", body)
+
+    def test_csv_headers_filename_and_encoding(self):
+        add_appointment(self.conn)
+        code, headers, body = request(self.app, "/appointments.csv", self.query)
+        self.assertEqual(code, 200)
+        self.assertEqual(headers["Content-Type"], "text/csv; charset=utf-8")
+        self.assertEqual(headers["Content-Disposition"],
+                         'attachment; filename="appointments_2026-10-01_2026-10-31_all.csv"')
+        self.assertEqual(headers["Cache-Control"], "no-store")
+        self.assertEqual(headers["X-Content-Type-Options"], "nosniff")
+        self.assertTrue(body.startswith(b"\xef\xbb\xbfdate,start,end,"))
+
+    def test_invalid_ranges_render_useful_errors_and_do_not_download(self):
+        for query, expected in (
+            ("start=2026-10-31&end=2026-10-01", "on or before"),
+            ("start=2026-02-30&end=2026-03-01", "valid calendar date"),
+            ("start=2026-10-01", "YYYY-MM-DD"),
+            (self.query.replace("status=all", "status=other"), "Status must"),
+            (self.query + "&status=done", "one value"),
+            (self.query + "&page=0", "1 or greater"),
+            (self.query + "&other=x", "choose your export"),
+        ):
+            with self.subTest(query=query):
+                code, headers, body = request(self.app, "/appointments.csv", query)
+                self.assertEqual(code, 400)
+                self.assertNotIn("Content-Disposition", headers)
+                self.assertIn(expected, body.decode())
+                self.assertIn(b'role="alert"', body)
+
+    def test_download_requires_explicit_dates(self):
+        self.assertEqual(request(self.app, "/appointments.csv")[0], 400)
+
+    def test_html_escapes_all_database_names(self):
+        name = '<script>alert("x")</script>'
+        for table in ("salon", "groomers", "clients", "dogs", "services"):
+            self.conn.execute(f"UPDATE {table} SET name = ? WHERE id = 1", (name,))
+        add_appointment(self.conn)
+        code, _, body = request(self.app, query=self.query)
+        self.assertEqual(code, 200)
+        self.assertNotIn(name, body.decode())
+        self.assertIn("&lt;script&gt;", body.decode())
+        self.assertNotIn(b"<script", body)
+
+    def test_error_form_escapes_query_values(self):
+        bad = '"><script>alert(1)</script>'
+        code, _, body = request(self.app, query=urlencode({"start": bad, "end": "2026-10-31"}))
+        self.assertEqual(code, 400)
+        self.assertNotIn(b"<script", body)
+        self.assertIn(b"&lt;script&gt;", body)
+
+    def test_local_access_guards(self):
+        rejected = (
+            {"REMOTE_ADDR": "203.0.113.5"}, {"REMOTE_ADDR": ""},
+            {"HTTP_HOST": "evil.example:8001"}, {"HTTP_HOST": "127.0.0.1:9999"},
+            {"HTTP_ORIGIN": "https://evil.example"}, {"HTTP_ORIGIN": "null"},
+            {"HTTP_SEC_FETCH_SITE": "cross-site"}, {"HTTP_SEC_FETCH_SITE": "same-site"},
+        )
+        for overrides in rejected:
+            for path in ("/", "/appointments.csv", "/assets/reports.css"):
+                with self.subTest(overrides=overrides, path=path):
+                    code, _, body = request(self.app, path, self.query, **overrides)
+                    self.assertEqual(code, 403)
+                    self.assertNotIn(b"Ana", body)
+
+    def test_same_origin_loopback_requests_work(self):
+        for host in ("127.0.0.1:8001", "localhost:8001", "[::1]:8001"):
+            with self.subTest(host=host):
+                self.assertEqual(request(self.app, HTTP_HOST=host, HTTP_ORIGIN="http://" + host,
+                                         HTTP_SEC_FETCH_SITE="same-origin")[0], 200)
+        self.assertEqual(request(self.app, REMOTE_ADDR="::1")[0], 200)
+
+    def test_security_headers_also_protect_html_and_errors(self):
+        for path in ("/", "/missing"):
+            _, headers, _ = request(self.app, path)
+            self.assertEqual(headers["Cache-Control"], "no-store")
+            self.assertEqual(headers["X-Frame-Options"], "DENY")
+            self.assertIn("form-action 'self'", headers["Content-Security-Policy"])
+            self.assertEqual(headers["Referrer-Policy"], "no-referrer")
+
+    def test_unsupported_methods_and_routes(self):
+        code, headers, _ = request(self.app, method="POST")
+        self.assertEqual(code, 405)
+        self.assertEqual(headers["Allow"], "GET")
+        self.assertEqual(request(self.app, "/missing")[0], 404)
+        self.assertEqual(request(self.app, "/assets/../db.py")[0], 404)
+        self.assertEqual(request(self.app, "/api/appointments", method="POST")[0], 405)
+
+    def test_stylesheet_is_served(self):
+        code, headers, body = request(self.app, "/assets/reports.css")
+        self.assertEqual(code, 200)
+        self.assertEqual(headers["Content-Type"], "text/css; charset=utf-8")
+        self.assertIn(b"@media", body)
+
+    def test_booking_app_does_not_expose_exports(self):
+        app = web.make_app(self.conn)
+        for path in ("/appointments.csv", "/reports", "/assets/reports.css"):
+            self.assertEqual(request(app, path, self.query)[0], 404)
+
+
+if __name__ == "__main__":
+    unittest.main()
