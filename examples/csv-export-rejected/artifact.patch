diff --git a/tests/test_export_cli.py b/tests/test_export_cli.py
new file mode 100644
index 0000000..e6b9a7e
--- /dev/null
+++ b/tests/test_export_cli.py
@@ -0,0 +1,112 @@
+import csv
+import io
+import os
+import sqlite3
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from fernhill.__main__ import main
+
+from .fixtures import salon_db
+from .test_exports import add_appointment
+
+
+class ExportCLITest(unittest.TestCase):
+    def setUp(self):
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        self.root = Path(directory.name)
+        self.db = self.root / "salon.db"
+        conn = salon_db()
+        add_appointment(conn, status="done")
+        add_appointment(conn, status="cancelled", dog=3)
+        conn.commit()
+        target = sqlite3.connect(self.db)
+        conn.backup(target)
+        target.close()
+        conn.close()
+        self.original = self.db.read_bytes()
+
+    def run_cli(self, *args, db=None):
+        return subprocess.run(
+            [sys.executable, "-m", "fernhill", "--db", str(db or self.db), *args],
+            capture_output=True, env={**os.environ, "PYTHONIOENCODING": "utf-8"})
+
+    def export(self, *args, db=None):
+        return self.run_cli("export", "--from", "2026-10-01", "--to", "2026-10-31", *args, db=db)
+
+    def test_stdout_is_csv_only_and_database_is_unchanged(self):
+        result = self.export()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        rows = list(csv.DictReader(io.StringIO(result.stdout.decode("utf-8-sig"))))
+        self.assertEqual([r["status"] for r in rows], ["done", "cancelled"])
+        self.assertIn(b"not amounts charged or paid", result.stderr)
+        self.assertNotIn(b"Prices are", result.stdout)
+        self.assertEqual(self.db.read_bytes(), self.original)
+
+    def test_output_file_and_status_filter(self):
+        output = self.root / "bookkeeper é.csv"
+        result = self.export("--status", "done", "--output", str(output))
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, b"")
+        with output.open(encoding="utf-8-sig", newline="") as stream:
+            rows = list(csv.DictReader(stream))
+        self.assertEqual(len(rows), 1)
+        self.assertEqual(rows[0]["status"], "done")
+
+    def test_existing_output_and_database_cannot_be_overwritten(self):
+        output = self.root / "existing.csv"
+        output.write_bytes(b"keep me")
+        for destination in (output, self.db):
+            result = self.export("--output", str(destination))
+            self.assertEqual(result.returncode, 2)
+            self.assertIn(b"File exists", result.stderr)
+        self.assertEqual(output.read_bytes(), b"keep me")
+        self.assertEqual(self.db.read_bytes(), self.original)
+
+    def test_invalid_range_creates_no_output(self):
+        output = self.root / "bad.csv"
+        result = self.run_cli("export", "--from", "2026-10-31", "--to", "2026-10-01",
+                              "--output", str(output))
+        self.assertEqual(result.returncode, 2)
+        self.assertIn(b"on or before", result.stderr)
+        self.assertFalse(output.exists())
+        self.assertEqual(result.stdout, b"")
+
+    def test_missing_database_is_not_created(self):
+        missing = self.root / "missing.db"
+        result = self.export(db=missing)
+        self.assertEqual(result.returncode, 2)
+        self.assertFalse(missing.exists())
+        self.assertEqual(result.stdout, b"")
+
+    def test_uninitialized_database_fails_before_writing_csv(self):
+        empty = self.root / "empty.db"
+        sqlite3.connect(empty).close()
+        output = self.root / "empty.csv"
+        result = self.export("--output", str(output), db=empty)
+        self.assertEqual(result.returncode, 2)
+        self.assertFalse(output.exists())
+
+    def test_reports_binds_only_to_loopback_and_uses_readonly_connection(self):
+        with patch("fernhill.__main__.make_server") as make_server, patch("sys.stdout", new=io.StringIO()) as out:
+            main(["--db", str(self.db), "reports", "--port", "8765"])
+            args = make_server.call_args.args
+            self.assertEqual(args[:2], ("127.0.0.1", 8765))
+            make_server.return_value.__enter__.return_value.serve_forever.assert_called_once()
+            self.assertIn("http://127.0.0.1:8765/", out.getvalue())
+        self.assertEqual(self.db.read_bytes(), self.original)
+
+    def test_invalid_reports_port_does_not_start_server(self):
+        for port in ("0", "65536", "-1"):
+            result = self.run_cli("reports", "--port", port)
+            self.assertEqual(result.returncode, 2)
+            self.assertIn(b"port must be", result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_exports.py b/tests/test_exports.py
