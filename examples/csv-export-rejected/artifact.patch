diff --git a/fernhill/exports.py b/fernhill/exports.py
new file mode 100644
index 0000000..49c3d48
--- /dev/null
+++ b/fernhill/exports.py
@@ -0,0 +1,138 @@
+"""Read-only appointment exports shared by the staff workspace and CLI.
+
+Prices are the current service catalog prices, not historical charges or payments.
+Dates/times use the salon's existing local-time convention.
+"""
+from __future__ import annotations
+
+import csv
+import io
+import re
+import sqlite3
+from dataclasses import dataclass
+from datetime import date
+from pathlib import Path
+from urllib.parse import urlencode
+
+STATUSES = ("booked", "done", "cancelled")
+COLUMNS = ("date", "start", "end", "groomer", "client", "dog", "service", "price", "status")
+PRICE_NOTE = ("Prices are current service catalog prices, not amounts charged or paid. "
+              "Past appointment prices change if you edit the service catalog. "
+              "Cancelled appointments keep their listed price.")
+
+
+def connect_readonly(path: str) -> sqlite3.Connection:
+    """Open an existing database without creating or migrating it."""
+    conn = sqlite3.connect(Path(path).resolve().as_uri() + "?mode=ro", uri=True)
+    conn.row_factory = sqlite3.Row
+    conn.execute("PRAGMA query_only = ON")
+    return conn
+
+
+def parse_date(value: str, label: str) -> date:
+    if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", value):
+        raise ValueError(f"{label} must be a date in YYYY-MM-DD format.")
+    try:
+        return date.fromisoformat(value)
+    except ValueError:
+        raise ValueError(f"{label} must be a valid calendar date.") from None
+
+
+@dataclass(frozen=True)
+class Selection:
+    start: date
+    end: date
+    status: str = "all"
+
+    def __post_init__(self):
+        if self.start > self.end:
+            raise ValueError("From date must be on or before To date.")
+        if self.status not in ("all", *STATUSES):
+            raise ValueError("Status must be all, booked, done, or cancelled.")
+
+    @classmethod
+    def parse(cls, start: str, end: str, status: str = "all") -> Selection:
+        return cls(parse_date(start, "From date"), parse_date(end, "To date"), status)
+
+    @property
+    def query(self) -> str:
+        return urlencode({"start": self.start.isoformat(), "end": self.end.isoformat(),
+                          "status": self.status})
+
+    @property
+    def filename(self) -> str:
+        return f"appointments_{self.start}_{self.end}_{self.status}.csv"
+
+    def where(self) -> tuple[str, list[str]]:
+        # Existing data uses ISO local timestamps. Compare their date portions so
+        # both boundary days are included, including appointments with seconds.
+        clause = "substr(a.start, 1, 10) BETWEEN ? AND ?"
+        params = [self.start.isoformat(), self.end.isoformat()]
+        if self.status != "all":
+            clause += " AND a.status = ?"
+            params.append(self.status)
+        return clause, params
+
+
+def appointments(conn: sqlite3.Connection, selection: Selection, *,
+                 limit: int | None = None, offset: int = 0):
+    """Iterate one row per appointment, including cancelled/done by default."""
+    where, params = selection.where()
+    sql = (
+        "SELECT a.id, a.start, a.end, g.name AS groomer, c.name AS client,"
+        " d.name AS dog, sv.name AS service, sv.price_cents, a.status"
+        " FROM appointments a"
+        " JOIN groomers g ON g.id = a.groomer_id"
+        " JOIN dogs d ON d.id = a.dog_id"
+        " JOIN clients c ON c.id = d.client_id"
+        " JOIN services sv ON sv.id = a.service_id"
+        f" WHERE {where} ORDER BY a.start, a.id"
+    )
+    if limit is not None:
+        sql += " LIMIT ? OFFSET ?"
+        params = [*params, limit, offset]
+    return conn.execute(sql, params)
+
+
+def counts(conn: sqlite3.Connection, selection: Selection) -> dict[str, int]:
+    where, params = selection.where()
+    totals = dict.fromkeys(STATUSES, 0)
+    for row in conn.execute(
+            f"SELECT a.status, COUNT(*) AS n FROM appointments a WHERE {where} GROUP BY a.status",
+            params):
+        totals[row["status"]] = row["n"]
+    return totals
+
+
+def price(cents: int) -> str:
+    """Format money from integer cents without float rounding or currency symbols."""
+    whole, fraction = divmod(abs(cents), 100)
+    return f"{'-' if cents < 0 else ''}{whole}.{fraction:02d}"
+
+
+def spreadsheet_text(value: str) -> str:
+    """Keep user-entered names from being treated as spreadsheet formulas.
+
+    CSV quoting alone does not stop formula evaluation. Prefix risky text with an
+    apostrophe; leave dates, times and numeric price cells in their native format.
+    """
+    if value.startswith(("\t", "\r", "\n")) or value.lstrip().startswith(("=", "+", "-", "@")):
+        return "'" + value
+    return value
+
+
+def csv_chunks(conn: sqlite3.Connection, selection: Selection):
+    """Yield UTF-8 CSV bytes with a BOM for Excel and standard CRLF row endings."""
+    buffer = io.StringIO(newline="")
+    writer = csv.writer(buffer, lineterminator="\r\n")
+    writer.writerow(COLUMNS)
+    yield b"\xef\xbb\xbf" + buffer.getvalue().encode("utf-8")
+    for row in appointments(conn, selection):
+        buffer.seek(0)
+        buffer.truncate(0)
+        writer.writerow([
+            row["start"][:10], row["start"][11:], row["end"][11:],
+            *(spreadsheet_text(row[key]) for key in ("groomer", "client", "dog", "service")),
+            price(row["price_cents"]), row["status"],
+        ])
+        yield buffer.getvalue().encode("utf-8")
