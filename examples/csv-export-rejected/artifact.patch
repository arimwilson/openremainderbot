+"""A separate, loopback-only staff workspace. Never mounted in the booking app."""
+from __future__ import annotations
+
+import calendar
+import ipaddress
+import sqlite3
+from datetime import date, timedelta
+from html import escape
+from pathlib import Path
+from urllib.parse import parse_qs
+
+from . import exports
+from .db import salon
+
+PAGE_SIZE = 50
+STATUS_LABELS = {"all": "All statuses", "booked": "Booked", "done": "Completed",
+                 "cancelled": "Cancelled"}
+CSS = Path(__file__).with_name("static").joinpath("reports.css")
+
+
+def month_range(today: date) -> tuple[date, date]:
+    return today.replace(day=1), today.replace(day=calendar.monthrange(today.year, today.month)[1])
+
+
+def default_selection(today: date) -> exports.Selection:
+    last_month_end = today.replace(day=1) - timedelta(days=1)
+    return exports.Selection(last_month_end.replace(day=1), last_month_end)
+
+
+def selections(today: date, status: str):
+    first, last = month_range(today)
+    previous = default_selection(today)
+    return (
+        ("Last month", exports.Selection(previous.start, previous.end, status)),
+        ("This month", exports.Selection(first, last, status)),
+        ("Last 30 days", exports.Selection(today - timedelta(days=29), today, status)),
+    )
+
+
+def date_label(day: date) -> str:
+    return f"{day.strftime('%b')} {day.day}, {day.year}"
+
+
+def table_row(row: sqlite3.Row) -> str:
+    day = date.fromisoformat(row["start"][:10])
+    cells = [
+        f'<time datetime="{day.isoformat()}">{escape(date_label(day))}</time>',
+        f'<span class="time">{escape(row["start"][11:])}–{escape(row["end"][11:])}</span>',
+        escape(row["groomer"]),
+        f'<strong>{escape(row["dog"])}</strong><span class="subtext">{escape(row["client"])}</span>',
+        escape(row["service"]),
+        f'<span class="amount">${exports.price(row["price_cents"])}</span>',
+        f'<span class="badge {escape(row["status"])}">{STATUS_LABELS[row["status"]]}</span>',
+    ]
+    return "<tr>" + "".join(f"<td>{cell}</td>" for cell in cells) + "</tr>"
+
+
+def render(conn: sqlite3.Connection, *, today: date, selection: exports.Selection | None,
+           values: dict[str, str], page: int = 1, error: str = "") -> str:
+    name = escape(salon(conn)["name"])
+    start = escape(values.get("start", ""), quote=True)
+    end = escape(values.get("end", ""), quote=True)
+    status = values.get("status", "all")
+    options = "".join(
+        f'<option value="{key}"{" selected" if key == status else ""}>{label}</option>'
+        for key, label in STATUS_LABELS.items())
+    shortcuts = "".join(
+        f'<a href="/?{escape(item.query, quote=True)}"'
+        f' aria-current="{str(item == selection).lower()}">{label}</a>'
+        for label, item in selections(today, status if status in STATUS_LABELS else "all"))
+    notice = (f'<div class="error" role="alert"><strong>Check your export filters.</strong> '
+              f'{escape(error)}</div>') if error else ""
+    if selection is not None:
+        totals = exports.counts(conn, selection)
+        total = sum(totals.values())
+        pages = max(1, (total + PAGE_SIZE - 1) // PAGE_SIZE)
+        page = min(page, pages)
+        offset = (page - 1) * PAGE_SIZE
+        rows = list(exports.appointments(conn, selection, limit=PAGE_SIZE, offset=offset))
+        summary = f"{date_label(selection.start)} – {date_label(selection.end)}"
+        cards = "".join(
+            f'<div class="stat"><span>{label}</span><strong>{count:,}</strong></div>'
+            for label, count in (("Appointments", total), ("Completed", totals["done"]),
+                                 ("Booked", totals["booked"]), ("Cancelled", totals["cancelled"])))
+        if rows:
+            content = f'''<p class="scroll-hint">Scroll sideways to see all columns →</p><div class="table-wrap" tabindex="0" role="region" aria-label="Appointment preview, scroll for more columns">
+<table><caption class="sr-only">Appointments from {escape(summary)}. Prices are current catalog prices.</caption>
+<thead><tr><th scope="col">Date</th><th scope="col">Time</th><th scope="col">Groomer</th>
+<th scope="col">Dog / client</th><th scope="col">Service</th><th scope="col">Listed price</th><th scope="col">Status</th></tr></thead>
+<tbody>{''.join(table_row(row) for row in rows)}</tbody></table></div>'''
+        else:
+            content = '''<div class="empty"><span class="empty-icon" aria-hidden="true">↗</span>
+<h3>No appointments in this range</h3><p>Try another date range or choose All statuses.</p>
+<p>You can still download a CSV with column headings.</p></div>'''
+        navigation = ""
+        if page > 1:
+            navigation += f'<a href="/?{escape(selection.query)}&amp;page={page - 1}" rel="prev">← Previous</a>'
+        if page < pages:
+            navigation += f'<a href="/?{escape(selection.query)}&amp;page={page + 1}" rel="next">Next →</a>'
+        showing = f"Showing {offset + 1}–{offset + len(rows)} of {total:,}" if rows else "0 appointments"
+        preview = f'''<section class="summary" aria-label="Export counts">{cards}</section>
+<section class="preview" aria-labelledby="preview-title">
+<div class="preview-heading"><div><p class="eyebrow">YOUR EXPORT</p><h2 id="preview-title">Appointment preview</h2>
+<p>{escape(summary)} <span aria-hidden="true">·</span> {STATUS_LABELS[selection.status]}</p></div>
+<span class="file-tag">CSV · {total:,} {"row" if total == 1 else "rows"}</span></div>
+{content}<div class="table-footer"><p>{showing}. Download includes all {total:,} matching {"row" if total == 1 else "rows"}.</p>
+<nav aria-label="Preview pages">{navigation}</nav></div></section>'''
+    else:
+        preview = '<section class="empty"><h2>Choose a valid date range to see your appointments.</h2></section>'
+    return f'''<!doctype html>
+<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Appointment exports · {name} · Fernhill</title><link rel="stylesheet" href="/assets/reports.css"></head>
+<body><a class="skip" href="#main">Skip to content</a>
+<header class="topbar"><a class="brand" href="/" aria-label="Fernhill exports home"><span class="brand-mark" aria-hidden="true">f</span>fernhill<span class="brand-divider"></span><span class="workspace">Reports</span></a>
+<div class="salon"><span class="local-dot" aria-hidden="true"></span>{name}<span class="local-label">Local workspace</span></div></header>
+<main id="main"><div class="breadcrumb">Reports <span aria-hidden="true">/</span> Appointments</div>
+<div class="intro"><div><p class="eyebrow">LESS ADMIN. MORE GOOD DOGS.</p><h1>Appointments, ready to share.</h1>
+<p>Take the month off your to-do list. Export your appointments for your bookkeeper.</p></div>
+<span class="intro-mark" aria-hidden="true">↗</span></div>
+<section class="filters" aria-labelledby="filters-title"><div class="filter-title"><h2 id="filters-title">Choose your date range</h2>
+<span>Both dates are included</span></div>{notice}
+<form method="get" action="/" aria-label="Appointment export filters">
+<div class="fields"><div><label for="start">From date</label><input id="start" name="start" type="date" value="{start}" required></div>
+<div><label for="end">To date</label><input id="end" name="end" type="date" value="{end}" required></div>
+<div><label for="status">Appointment status</label><select id="status" name="status">{options}</select></div>
+<div class="actions"><button class="secondary" type="submit">Preview</button><button class="primary" type="submit" formaction="/appointments.csv">Download CSV <span aria-hidden="true">↓</span></button></div></div>
+<div class="filter-bottom"><nav aria-label="Common date ranges">{shortcuts}</nav><span>Local salon time · All groomers</span></div>
+</form></section>{preview}
+<aside class="notes" aria-labelledby="export-notes"><div class="note-symbol" aria-hidden="true">i</div>
+<div><h2 id="export-notes">A clear handoff to your bookkeeper</h2><p>{escape(exports.PRICE_NOTE)}</p>
+<p>Includes date, start, end, groomer, client, dog, service, price and status. UTF-8 CSV for Excel and Google Sheets.
+Names that could be read as formulas get a leading apostrophe.</p></div></aside>
+<footer><span>Fernhill <span aria-hidden="true">/</span> A little less busywork.</span><span>Staff workspace · This computer only</span></footer>
+</main></body></html>'''
+
+
+def local_request(environ) -> bool:
+    """Reject remote clients, DNS rebinding and cross-site browser requests."""
+    try:
+        if not ipaddress.ip_address(environ.get("REMOTE_ADDR", "")).is_loopback:
+            return False
+    except ValueError:
+        return False
+    port = environ.get("SERVER_PORT", "")
+    hosts = {f"127.0.0.1:{port}", f"localhost:{port}", f"[::1]:{port}"}
+    if port == "80":
+        hosts.update({"127.0.0.1", "localhost", "[::1]"})
+    host = environ.get("HTTP_HOST", "").lower()
+    if host not in hosts:
+        return False
+    origin = environ.get("HTTP_ORIGIN")
+    if origin is not None and origin != f"http://{host}":
+        return False
+    return environ.get("HTTP_SEC_FETCH_SITE") not in {"cross-site", "same-site"}
+
+
+def make_app(conn: sqlite3.Connection, *, today: date | None = None):
+    """Create the staff app. The CLI binds it to 127.0.0.1, on a separate port."""
+    def app(environ, start_response):
+        headers = [("Cache-Control", "no-store"), ("X-Content-Type-Options", "nosniff"),
+                   ("X-Frame-Options", "DENY"), ("Referrer-Policy", "no-referrer"),
+                   ("Content-Security-Policy", "default-src 'none'; style-src 'self'; "
+                    "form-action 'self'; frame-ancestors 'none'; base-uri 'none'")]
+
+        def reply(status, body, content_type="text/plain", extra=()):
+            data = body.encode("utf-8")
+            start_response(status, [*headers, ("Content-Type", content_type + "; charset=utf-8"),
+                                    ("Content-Length", str(len(data))), *extra])
+            return [data]
+
+        if not local_request(environ):
+            return reply("403 Forbidden", "Open this staff workspace directly on this computer.")
+        if environ["REQUEST_METHOD"] != "GET":
+            return reply("405 Method Not Allowed", "Use GET to preview or download appointments.",
+                         extra=[("Allow", "GET")])
+        path = environ.get("PATH_INFO", "/")
+        if path == "/assets/reports.css":
+            return reply("200 OK", CSS.read_text(encoding="utf-8"), "text/css")
+        if path not in {"/", "/appointments.csv"}:
+            return reply("404 Not Found", "Page not found.")
+        current_day = today if today is not None else date.today()
+        values = {}
+        try:
+            query = parse_qs(environ.get("QUERY_STRING", ""), keep_blank_values=True,
+                             max_num_fields=12)
+            if any(len(v) != 1 for v in query.values()):
+                raise ValueError("Choose one value for each export field.")
+            if set(query) - {"start", "end", "status", "page"}:
+                raise ValueError("Use From date, To date, and Appointment status to choose your export.")
+            values = {k: v[0] for k, v in query.items()}
+            if not values and path == "/":
+                initial = default_selection(current_day)
+                values = {"start": initial.start.isoformat(), "end": initial.end.isoformat(), "status": "all"}
+            selection = exports.Selection.parse(values.get("start", ""), values.get("end", ""),
+                                                 values.get("status", "all"))
+            page = int(values.get("page", "1"))
+            if page < 1:
+                raise ValueError("Preview page must be 1 or greater.")
+        except ValueError as exc:
+            return reply("400 Bad Request", render(conn, today=current_day, selection=None,
+                         values=values, error=str(exc)), "text/html")
+        if path == "/appointments.csv":
+            start_response("200 OK", [*headers, ("Content-Type", "text/csv; charset=utf-8"),
+                           ("Content-Disposition", f'attachment; filename="{selection.filename}"')])
+            return exports.csv_chunks(conn, selection)
+        return reply("200 OK", render(conn, today=current_day, selection=selection,
+                                      values=values, page=page), "text/html")
+    return app
