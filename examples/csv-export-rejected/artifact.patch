+import csv
+import io
+import sqlite3
+import tempfile
+import unittest
+from datetime import date
+from pathlib import Path
+
+from fernhill import exports
+
+from .fixtures import salon_db
+
+
+def add_appointment(conn, start="2026-10-13T09:00", end="2026-10-13T09:45", *,
+                    status="booked", dog=1, groomer=1, service=1):
+    return conn.execute(
+        "INSERT INTO appointments (dog_id, groomer_id, service_id, start, end, status)"
+        " VALUES (?, ?, ?, ?, ?, ?)", (dog, groomer, service, start, end, status)).lastrowid
+
+
+def read_csv(conn, selection):
+    raw = b"".join(exports.csv_chunks(conn, selection))
+    return raw, list(csv.DictReader(io.StringIO(raw.decode("utf-8-sig"), newline="")))
+
+
+class ExportsTest(unittest.TestCase):
+    def setUp(self):
+        self.conn = salon_db()
+        self.addCleanup(self.conn.close)
+        self.selection = exports.Selection.parse("2026-10-01", "2026-10-31")
+
+    def test_export_has_requested_columns_and_exact_data(self):
+        add_appointment(self.conn)
+        raw, rows = read_csv(self.conn, self.selection)
+        self.assertEqual(list(rows[0]), list(exports.COLUMNS))
+        self.assertEqual(rows, [{"date": "2026-10-13", "start": "09:00", "end": "09:45",
+                                "groomer": "Jess", "client": "Ana Ruiz", "dog": "Biscuit",
+                                "service": "Bath and brush", "price": "45.00", "status": "booked"}])
+        self.assertTrue(raw.startswith(b"\xef\xbb\xbf"))
+        self.assertEqual(raw.count(b"\xef\xbb\xbf"), 1)
+        self.assertTrue(raw.endswith(b"\r\n"))
+        self.assertNotIn(b"phone", raw)
+        self.assertNotIn(b"email", raw)
+
+    def test_both_boundary_days_are_included_and_outside_days_excluded(self):
+        for day in ("2026-09-30", "2026-10-01", "2026-10-31", "2026-11-01"):
+            add_appointment(self.conn, f"{day}T23:59:30", f"{day}T23:59:59")
+        _, rows = read_csv(self.conn, self.selection)
+        self.assertEqual([r["date"] for r in rows], ["2026-10-01", "2026-10-31"])
+        self.assertEqual(rows[-1]["start"], "23:59:30")
+
+    def test_same_day_range(self):
+        add_appointment(self.conn)
+        _, rows = read_csv(self.conn, exports.Selection.parse("2026-10-13", "2026-10-13"))
+        self.assertEqual(len(rows), 1)
+
+    def test_all_statuses_are_exported_by_default(self):
+        for status in exports.STATUSES:
+            add_appointment(self.conn, status=status)
+        _, rows = read_csv(self.conn, self.selection)
+        self.assertEqual([r["status"] for r in rows], list(exports.STATUSES))
+        self.assertEqual(exports.counts(self.conn, self.selection), {"booked": 1, "done": 1, "cancelled": 1})
+
+    def test_each_status_filter_applies_to_rows_and_counts(self):
+        for status in exports.STATUSES:
+            add_appointment(self.conn, status=status)
+        for status in exports.STATUSES:
+            with self.subTest(status=status):
+                selection = exports.Selection(self.selection.start, self.selection.end, status)
+                _, rows = read_csv(self.conn, selection)
+                self.assertEqual([r["status"] for r in rows], [status])
+                self.assertEqual(sum(exports.counts(self.conn, selection).values()), 1)
+
+    def test_empty_export_still_has_headers(self):
+        raw, rows = read_csv(self.conn, self.selection)
+        self.assertEqual(rows, [])
+        self.assertEqual(raw.decode("utf-8-sig"), ",".join(exports.COLUMNS) + "\r\n")
+        self.assertEqual(exports.counts(self.conn, self.selection), {"booked": 0, "done": 0, "cancelled": 0})
+
+    def test_stable_chronological_order_with_ties(self):
+        late = add_appointment(self.conn, "2026-10-13T15:00", "2026-10-13T15:45")
+        first = add_appointment(self.conn, groomer=2)
+        second = add_appointment(self.conn, groomer=1)
+        self.assertEqual([r["id"] for r in exports.appointments(self.conn, self.selection)], [first, second, late])
+
+    def test_preview_pagination_does_not_limit_csv(self):
+        for _ in range(125):
+            add_appointment(self.conn)
+        preview = list(exports.appointments(self.conn, self.selection, limit=50, offset=50))
+        self.assertEqual([r["id"] for r in preview], list(range(51, 101)))
+        self.assertEqual(len(read_csv(self.conn, self.selection)[1]), 125)
+
+    def test_accents_quotes_commas_and_multiline_names_roundtrip(self):
+        names = {"groomers": 'Zoë, "Z"', "clients": "José\r\nGarcía", "dogs": "大福 🐾",
+                 "services": 'Bath, brush & "tidy"'}
+        for table, name in names.items():
+            self.conn.execute(f"UPDATE {table} SET name = ? WHERE id = 1", (name,))
+        add_appointment(self.conn)
+        _, rows = read_csv(self.conn, self.selection)
+        for column, table in (("groomer", "groomers"), ("client", "clients"),
+                              ("dog", "dogs"), ("service", "services")):
+            self.assertEqual(rows[0][column], names[table])
+
+    def test_spreadsheet_formulas_are_neutralized_in_every_name_column(self):
+        for table, name in (("groomers", '=HYPERLINK("https://example.invalid")'),
+                            ("clients", " +123"), ("dogs", "\t@SUM(1,2)"), ("services", "-10")):
+            self.conn.execute(f"UPDATE {table} SET name = ? WHERE id = 1", (name,))
+        add_appointment(self.conn)
+        _, rows = read_csv(self.conn, self.selection)
+        for column in ("groomer", "client", "dog", "service"):
+            self.assertTrue(rows[0][column].startswith("'"))
+        self.assertEqual(rows[0]["price"], "45.00")
+        self.assertEqual(rows[0]["date"], "2026-10-13")
+
+    def test_formula_prefix_and_safe_text_examples(self):
+        for value in ("=1", "+1", "-1", "@A1", "  =1", "\rHello", "\nHello", "\tHello", "\u00a0=1"):
+            with self.subTest(value=value):
+                self.assertEqual(exports.spreadsheet_text(value), "'" + value)
+        for value in ("", "Zoë", "O'Brien", "Two\nlines", "Dr. @ Groom", "  Biscuit"):
+            with self.subTest(value=value):
+                self.assertEqual(exports.spreadsheet_text(value), value)
+
+    def test_price_uses_current_catalog_and_integer_precision(self):
+        add_appointment(self.conn)
+        self.conn.execute("UPDATE services SET price_cents = 12345678901234567 WHERE id = 1")
+        self.assertEqual(read_csv(self.conn, self.selection)[1][0]["price"], "123456789012345.67")
+        for cents, expected in ((0, "0.00"), (1, "0.01"), (999, "9.99"), (-105, "-1.05")):
+            self.assertEqual(exports.price(cents), expected)
+
+    def test_range_validation(self):
+        bad_ranges = (("2026-10-31", "2026-10-01"), ("", "2026-10-01"),
+                      ("20261001", "2026-10-31"), ("2026-02-29", "2026-03-01"),
+                      ("2026-10-01T10:00", "2026-10-31"), ("x' OR 1=1--", "2026-10-31"))
+        for start, end in bad_ranges:
+            with self.subTest(start=start, end=end), self.assertRaises(ValueError):
+                exports.Selection.parse(start, end)
+        for status in ("", "completed", "all' OR 1=1--"):
+            with self.subTest(status=status), self.assertRaises(ValueError):
+                exports.Selection.parse("2026-10-01", "2026-10-31", status)
+
+    def test_leap_day_and_max_date_work(self):
+        for day in ("2024-02-29", "9999-12-31"):
+            add_appointment(self.conn, f"{day}T09:00", f"{day}T09:45")
+            self.assertEqual(len(read_csv(self.conn, exports.Selection.parse(day, day))[1]), 1)
+
+    def test_readonly_connection_never_creates_or_modifies_database(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory, "salon with spaces & accents é.db")
+            with self.assertRaises(sqlite3.OperationalError):
+                exports.connect_readonly(str(path))
+            self.assertFalse(path.exists())
+            target = sqlite3.connect(path)
+            self.conn.backup(target)
+            target.close()
+            before = path.read_bytes()
+            conn = exports.connect_readonly(str(path))
+            try:
+                self.assertEqual(read_csv(conn, self.selection)[1], [])
+                with self.assertRaises(sqlite3.OperationalError):
+                    conn.execute("DELETE FROM clients")
+            finally:
+                conn.close()
+            self.assertEqual(path.read_bytes(), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
