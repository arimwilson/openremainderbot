diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..82a3740
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,149 @@
+import csv
+import io
+import re
+import unittest
+from datetime import date
+
+from fernhill import export, staff
+
+from .fixtures import salon_db
+from .test_staff import call
+
+OCT_1, OCT_31 = date(2026, 10, 1), date(2026, 10, 31)
+
+
+def add(conn, start, end, status="booked", dog=1, groomer=1, service=1):
+    conn.execute("INSERT INTO appointments (dog_id, groomer_id, service_id, start, end, status)"
+                 " VALUES (?, ?, ?, ?, ?, ?)", (dog, groomer, service, start, end, status))
+    conn.commit()
+
+
+def read(data: bytes):
+    return list(csv.reader(io.StringIO(data.decode("utf-8-sig"), newline="")))
+
+
+class ExportTest(unittest.TestCase):
+    def setUp(self):
+        self.conn = salon_db()
+        self.addCleanup(self.conn.close)
+
+    def test_one_row_per_appointment_in_range_with_every_status(self):
+        add(self.conn, "2026-09-30T16:00", "2026-09-30T16:45")             # before
+        add(self.conn, "2026-10-01T09:00", "2026-10-01T09:45")
+        add(self.conn, "2026-10-13T11:00", "2026-10-13T13:30", "cancelled", dog=2, groomer=2, service=2)
+        add(self.conn, "2026-10-13T09:30", "2026-10-13T10:30", "done", dog=3)
+        add(self.conn, "2026-10-31T16:00", "2026-10-31T16:45")             # last day counts
+        add(self.conn, "2026-11-01T09:00", "2026-11-01T09:45")             # after
+        rows = read(export.to_csv(self.conn, OCT_1, OCT_31))
+        self.assertEqual(rows[0], list(export.COLUMNS))
+        self.assertEqual(rows[1:], [
+            ["2026-10-01", "09:00", "09:45", "Jess", "Ana Ruiz", "Biscuit", "Bath and brush", "45.00", "booked"],
+            ["2026-10-13", "09:30", "10:30", "Jess", "Lena Park", "Pepper", "Bath and brush", "45.00", "done"],
+            ["2026-10-13", "11:00", "13:30", "Marco", "Ana Ruiz", "Moose", "Full groom", "85.00", "cancelled"],
+            ["2026-10-31", "16:00", "16:45", "Jess", "Ana Ruiz", "Biscuit", "Bath and brush", "45.00", "booked"],
+        ])
+
+    def test_empty_range_is_just_the_header(self):
+        self.assertEqual(export.to_csv(self.conn, OCT_1, OCT_31),
+                         b"\xef\xbb\xbfdate,start,end,groomer,client,dog,service,price,status\r\n")
+
+    def test_commas_quotes_accents_and_line_breaks_survive_a_spreadsheet(self):
+        self.conn.execute("UPDATE clients SET name = 'Ruiz, Ana' WHERE id = 1")
+        self.conn.execute("UPDATE dogs SET name = 'Biscuit \"Bis\"' WHERE id = 1")
+        self.conn.execute("UPDATE groomers SET name = 'Zoë Ñúñez' WHERE id = 1")
+        self.conn.execute("UPDATE services SET name = 'Bath\nand brush' WHERE id = 1")
+        add(self.conn, "2026-10-13T09:00", "2026-10-13T09:45")
+        data = export.to_csv(self.conn, OCT_1, OCT_31)
+        self.assertTrue(data.startswith(b"\xef\xbb\xbf"))  # Excel reads UTF-8 only with the BOM
+        self.assertIn('"Ruiz, Ana","Biscuit ""Bis""","Bath\nand brush"'.encode(), data)
+        self.assertTrue(data.endswith(b"\r\n"))
+        self.assertEqual(read(data)[1][3:7], ["Zoë Ñúñez", "Ruiz, Ana", 'Biscuit "Bis"', "Bath\nand brush"])
+
+    def test_names_that_look_like_formulas_stay_text(self):
+        for value in ("=1+1", "+15035550142", "-Max", "@SUM(A1)", "  =HYPERLINK(1)", "\tTab",
+                      "\rCR", " =1"):
+            with self.subTest(value=value):
+                self.assertEqual(export.safe_text(value), "'" + value)
+        for value in ("", "Zoë", "O'Brien", "Max-a-million", "Dr. @ Groom", " Biscuit", "Two\nlines"):
+            with self.subTest(value=value):
+                self.assertEqual(export.safe_text(value), value)
+        self.conn.execute("UPDATE clients SET name = '=HYPERLINK(\"http://x.invalid\",\"pay\")'")
+        add(self.conn, "2026-10-13T09:00", "2026-10-13T09:45")
+        row = read(export.to_csv(self.conn, OCT_1, OCT_31))[1]
+        self.assertEqual(row[4], "'=HYPERLINK(\"http://x.invalid\",\"pay\")")
+        self.assertEqual(row[0], "2026-10-13")  # dates, times and prices are left alone
+
+    def test_price_is_exact_from_cents(self):
+        for cents, text in ((0, "0.00"), (5, "0.05"), (4500, "45.00"), (12999, "129.99"),
+                            (-105, "-1.05")):
+            self.assertEqual(export.price(cents), text)
+
+    def test_date_range_checks(self):
+        self.assertEqual(export.parse_range("2026-10-13", "2026-10-13"),
+                         (date(2026, 10, 13), date(2026, 10, 13)))
+        for start, end, message in (
+                ("2026-10-31", "2026-10-01", "on or before"),
+                ("", "2026-10-31", "From date must look like"),
+                ("2026-10-01", "10/31/2026", "To date must look like"),
+                ("2026-02-30", "2026-03-01", "isn't on the calendar"),
+                ("2026-10-01T00:00", "2026-10-31", "From date must look like"),
+                ("2026-10-01' OR 1=1--", "2026-10-31", "From date must look like")):
+            with self.subTest(start=start, end=end), self.assertRaisesRegex(export.ExportError, message):
+                export.parse_range(start, end)
+
+    def test_default_range_is_the_calendar_month(self):
+        self.assertEqual(export.this_month(date(2026, 10, 8)), (OCT_1, OCT_31))
+        self.assertEqual(export.this_month(date(2026, 12, 31)), (date(2026, 12, 1), date(2026, 12, 31)))
+        self.assertEqual(export.this_month(date(2028, 2, 1)), (date(2028, 2, 1), date(2028, 2, 29)))
+        self.assertEqual(export.this_month(date(2026, 4, 30)), (date(2026, 4, 1), date(2026, 4, 30)))
+
+
+class ExportRouteTest(unittest.TestCase):
+    def setUp(self):
+        self.conn = salon_db()
+        self.addCleanup(self.conn.close)
+        self.app = staff.make_app(self.conn)
+
+    def test_download_is_an_attachment_csv(self):
+        add(self.conn, "2026-10-13T09:00", "2026-10-13T09:45")
+        result = call(self.app, path="/export.csv", query="from=2026-10-01&to=2026-10-31")
+        self.assertEqual(result["status"], 200)
+        self.assertEqual(result["headers"]["Content-Type"], "text/csv; charset=utf-8")
+        self.assertEqual(result["headers"]["Content-Disposition"],
+                         'attachment; filename="fernhill-appointments-2026-10-01-to-2026-10-31.csv"')
+        self.assertEqual(result["headers"]["Cache-Control"], "no-store")
+        self.assertEqual(result["headers"]["Content-Length"],
+                         str(len(result["body"].encode("utf-8"))))
+        self.assertTrue(result["body"].startswith("﻿date,start,end,"))
+        self.assertIn("2026-10-13,09:00,09:45,Jess,Ana Ruiz,Biscuit,Bath and brush,45.00,booked\r\n",
+                      result["body"])
+
+    def test_bad_ranges_get_a_plain_message(self):
+        for query in ("from=2026-10-31&to=2026-10-01", "from=2026-10-01", "", "from=2026-13-01&to=2026-12-31"):
+            with self.subTest(query=query):
+                result = call(self.app, path="/export.csv", query=query)
+                self.assertEqual(result["status"], 400)
+                self.assertEqual(result["headers"]["Content-Type"], "text/plain; charset=utf-8")
+                self.assertNotIn("Content-Disposition", result["headers"])
+
