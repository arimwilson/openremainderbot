+
+## CSV export for bookkeepers
+
+The staff screen has a **Download CSV** form: pick a From and To date (it starts on
+this month) and the browser saves `fernhill-appointments-<from>-to-<to>.csv`, one row
+per appointment with `date, start, end, groomer, client, dog, service, price, status`.
+Cancelled and done appointments are included; filter on `status` in the spreadsheet.
+`price` is the service's current price, since Fernhill doesn't store what was charged.
+
+The file is UTF-8 with a byte-order mark and standard CSV quoting, so names with commas,
+quotes and accents open cleanly in Excel, Numbers and Google Sheets. Names that start
+with `=`, `+`, `-` or `@` get a leading `'` so a spreadsheet shows them as text (the `'`
+stays visible) instead of running them as a formula. The same file is at
+`GET /export.csv?from=2026-10-01&to=2026-10-31` on the staff port.
diff --git a/fernhill/export.py b/fernhill/export.py
new file mode 100644
index 0000000..5852655
--- /dev/null
+++ b/fernhill/export.py
@@ -0,0 +1,85 @@
+"""Appointments as a CSV for the salon's bookkeeper, downloaded from the staff screen.
+
+One row per appointment in the date range, every status. Prices are the service's
+current price: Fernhill does not store what was charged.
+"""
+from __future__ import annotations
+
+import csv
+import io
+import re
+import sqlite3
+from datetime import date, timedelta
+
+COLUMNS = ("date", "start", "end", "groomer", "client", "dog", "service", "price", "status")
+
+
+class ExportError(ValueError):
+    """A date range the export can't use; the message is shown to staff."""
+
+
+def parse_range(start: str, end: str) -> tuple[date, date]:
+    days = []
+    for label, value in (("From", start), ("To", end)):
+        if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", value or ""):
+            raise ExportError(f"{label} date must look like 2026-10-31.")
+        try:
+            days.append(date.fromisoformat(value))
+        except ValueError:
+            raise ExportError(f"{label} date {value} isn't on the calendar.") from None
+    if days[0] > days[1]:
+        raise ExportError("Pick a From date on or before the To date.")
+    return days[0], days[1]
+
+
+def this_month(today: date) -> tuple[date, date]:
+    """The form's default range: the calendar month, as bookkeepers ask for it."""
+    first = today.replace(day=1)
+    return first, (first + timedelta(days=31)).replace(day=1) - timedelta(days=1)
+
+
+def filename(start: date, end: date) -> str:
+    return f"fernhill-appointments-{start}-to-{end}.csv"
+
+
+def safe_text(value: str) -> str:
+    """Stop Excel and Sheets from running a name as a formula.
+
+    CSV quoting does not prevent that, so names starting with = + - @ or a control
+    character get a leading apostrophe and open as text, apostrophe included.
+    """
+    if value.startswith(("\t", "\r", "\n")) or value.lstrip().startswith(("=", "+", "-", "@")):
+        return "'" + value
+    return value
+
+
+def price(cents: int) -> str:
+    whole, part = divmod(abs(cents), 100)
+    return f"{'-' if cents < 0 else ''}{whole}.{part:02d}"
+
+
+def rows(conn: sqlite3.Connection, start: date, end: date):
+    # start is 'YYYY-MM-DDTHH:MM'; compare the date part so both end days are included.
+    return conn.execute(
+        "SELECT a.start, a.end, g.name AS groomer, c.name AS client, d.name AS dog,"
+        " s.name AS service, s.price_cents, a.status"
+        " FROM appointments a"
+        " JOIN groomers g ON g.id = a.groomer_id"
+        " JOIN dogs d ON d.id = a.dog_id"
+        " JOIN clients c ON c.id = d.client_id"
+        " JOIN services s ON s.id = a.service_id"
+        " WHERE substr(a.start, 1, 10) BETWEEN ? AND ?"
+        " ORDER BY a.start, g.name, a.id", (start.isoformat(), end.isoformat()))
+
+
+def to_csv(conn: sqlite3.Connection, start: date, end: date) -> bytes:
+    """UTF-8 with a BOM so Excel reads accents, CRLF line ends, standard quoting."""
+    out = io.StringIO(newline="")
+    writer = csv.writer(out, lineterminator="\r\n")
+    writer.writerow(COLUMNS)
+    for row in rows(conn, start, end):
+        writer.writerow([
+            row["start"][:10], row["start"][11:16], row["end"][11:16],
+            *(safe_text(row[key]) for key in ("groomer", "client", "dog", "service")),
+            price(row["price_cents"]), row["status"]])
+    return b"\xef\xbb\xbf" + out.getvalue().encode("utf-8")
